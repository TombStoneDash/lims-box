{
  "name": "lims-box",
  "version": "1.0.0",
  "description": "LIMS BOX — Modern lab management for small environmental and water testing labs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:synthetic": "node scripts/gen-synthetic-lims.mjs",
    "test:synthetic": "node --test tests/synthetic/shape.test.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:bot": "node --import tsx --test tests/bot/engine.test.ts tests/bot/telemetry.test.ts",
    "test:notify": "node --import tsx --test tests/notify/fallback.test.ts",
    "test:person-detail": "node --import tsx --test tests/admin/person-detail-server-boundary.test.ts",
    "test:commercial-claims": "node --import tsx --test tests/content/commercial-claims.test.ts",
    "test:unsubscribe": "node --import tsx --test tests/unsubscribe/contract.test.ts",
    "test:attribution": "node --import tsx --test tests/attribution/lead-source.test.ts",
    "test:host-redirects": "node --import tsx --test tests/ops/host-redirects.test.ts",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "vercel-build": "npm run test:bot && npm run test:unsubscribe && npm run test:attribution && npm run test:host-redirects && npm run typecheck && prisma generate && prisma db push --skip-generate && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.103.3",
    "fflate": "^0.8.3",
    "lucide-react": "^0.294.0",
    "next": "^15.5.7",
    "pdfkit": "^0.18.0",
    "prisma": "^6.19.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "8.5.15",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.22.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.15"
    }
  }
}
