# ─────────────────────────────────────────────────────────────────────────────
# LIMS BOX — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Neon Postgres — required in production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Demo operator Basic Auth — gates /demo/operator, /admin, /senaite-demo,
# and all personnel/admin APIs.
# Missing either value fails closed with HTTP 503.
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=changeme

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Personnel Pack lead-gen PDF
# The reviewed PDF is bundled under public/personnel-pack-assets and verified
# against its pinned SHA-256 before the fulfillment API returns its public URL.
# No PDF URL environment variable is used.
#
# Signing key for the single-use ?claim= on emailed download links. One stable
# random value shared by every instance. Missing it fails closed: POST returns
# 503 (no lead saved, no email sent) and claim links return 503.
PERSONNEL_PACK_DOWNLOAD_CLAIM_SECRET=

# Vercel (auto-injected in Vercel deployments — do not set manually)
# VERCEL_ENV=production|preview|development
