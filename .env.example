# ─────────────────────────────────────────────────────────────────────────────
# LIMS BOX — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Neon Postgres — required in production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin Basic Auth — gates /admin/* and /senaite-demo/* routes
# Leave blank to skip auth (useful for local dev without a password prompt)
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=changeme

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel (auto-injected in Vercel deployments — do not set manually)
# VERCEL_ENV=production|preview|development
